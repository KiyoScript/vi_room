<div class="row container-fluid p-4 mt-4">
  <div class="col-12 col-lg-6">
    <div class="card custom-shadow-primary">
      <div class="card-header p-3">
        <h5 class="mb-0 text-primary">Create Class</h5>
      </div>
      <div class="card-body p-4">
        <%= form_for(@class_subject) do |form| %>
            <%= form.hidden_field :code, value: Faker::Alphanumeric.alphanumeric(number: 6) %>
          <div class="form-group gap-2">
            <%= form.label :name, "Class Title", class: "card-title my-2", style: "font-size: 1.2rem" %>
            <%= form.text_field :name, autofocus: true, autocomplete: "title", required: true, class: "form-control" %>
          </div>
          <div class="form-group gap-2">
            <%= form.label :description, "Class Description", class: "card-title my-2", style: "font-size: 1.2rem" %>
            <%= form.text_field :description, autofocus: true, autocomplete: "description", required: true, class: "form-control" %>
          </div>
            <%= form.submit "Create",  class: "btn btn-primary mt-2" %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card custom-shadow-primary">
      <div class="card-header p-3">
        <h5 class="mb-0 text-primary">Metric Manager</h5>
      </div>
      <div class="card-body d-flex flex-column gap-2">
        <div class="form-group">
          <select class="form-select" id="exampleSelect1">
            <option>Select Class</option>
            <option>CCNA</option>
            <option>Advance Database Management</option>
          </select>
        </div>
        <div class="form-group d-flex flex-row gap-2">
          <input type="text" class="form-control" id="addMetric" placeholder="attendance">
          <input type="number" class="form-control" id="addPercentage" placeholder="20%">
          <button class="btn btn-primary"><%= bootstrap_icon 'plus-circle'%></button>
        </div>
      </div>
    </div>
  </div>
</div>
