<div class="container py-5">
  <div class="header text-end">
   <p class="text-primary">Edit background <%= bootstrap_icon 'pencil-square'%></p>
  </div>
  <div class="row">
    <div class="col-lg-4">
      <div class="card mb-4 custom-shadow-primary">
        <div class="card-header text-end text-primary">
          <%= bootstrap_icon 'pencil-square'%>
        </div>
        <div class="card-body text-center">
          <img src="https://avatars.githubusercontent.com/u/121840912?v=4" alt="avatar"
            class="rounded-circle img-fluid" style="width: 150px;">
          <h5 class="my-3"><%= current_user.fullname %></h5>
          <p class="fw-bold mb-1">😴<%= current_user.status %></p>
        </div>
      </div>
      <div class="card mb-4 mb-lg-0 custom-shadow-primary">
         <div class="card-header text-end text-primary">
          <%= bootstrap_icon 'pencil-square'%>
        </div>
        <div class="card-body p-0">
          <ul class="list-group list-group-flush rounded-3">
            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
              <%= bootstrap_icon 'github'%>
              <a href="https://github.com/KiyoScript" class="mb-0 text-decoration-none">KiyoScript</a>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
              <%= bootstrap_icon 'facebook'%>
              <p class="mb-0">John Lloyd de Sape</p>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center p-3">
              <%= bootstrap_icon 'linkedin'%>
              <p class="mb-0">@KiyoScript</p>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="card mb-4 custom-shadow-primary">
        <div class="card-header text-end text-primary">
          <%= bootstrap_icon 'pencil-square'%>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-sm-3">
              <p class="mb-0">Role</p>
            </div>
            <div class="col-sm-9">
              <p class="text-primary mb-0"><%= current_user.role%></p>
            </div>
          </div>
          <hr>
          <div class="row">
            <div class="col-sm-3">
              <p class="mb-0">Full Name</p>
            </div>
            <div class="col-sm-9">
              <p class="text-primary mb-0"><%= current_user.fullname%></p>
            </div>
          </div>
          <hr>
          <div class="row">
            <div class="col-sm-3">
              <p class="mb-0">Email</p>
            </div>
            <div class="col-sm-9">
              <p class="text-primary mb-0"><%= current_user.email %></p>
            </div>
          </div>
          <hr>
          <div class="row">
            <div class="col-sm-3">
              <p class="mb-0">Phone</p>
            </div>
            <div class="col-sm-9">
              <p class="text-primary mb-0"><%= current_user.phone_number %></p>
            </div>
          </div>
          <hr>
          <div class="row">
            <div class="col-sm-3">
              <p class="mb-0">Section/Program & Year</p>
            </div>
            <div class="col-sm-9">
              <p class="text-primary mb-0"><%= current_user.section_program_year%></p>
            </div>
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-6">
          <div class="card mb-4 mb-md-0 custom-shadow-primary">
            <div class="card-body">
              <p class="mb-4"><span class="text-primary font-italic me-1">Class</span> Progress <span class="text-primary">%</span>
              </p>
              <p class="mb-1" style="font-size: .77rem;">Event Driven Programming</p>
              <div class="progress rounded" style="height: 5px;">
                <div class="progress-bar" role="progressbar" style="width: 80%" aria-valuenow="80"
                  aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <p class="mt-4 mb-1" style="font-size: .77rem;">Advance Database Management</p>
              <div class="progress rounded" style="height: 5px;">
                <div class="progress-bar" role="progressbar" style="width: 72%" aria-valuenow="72"
                  aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <p class="mt-4 mb-1" style="font-size: .77rem;">Scaling Networks</p>
              <div class="progress rounded" style="height: 5px;">
                <div class="progress-bar" role="progressbar" style="width: 89%" aria-valuenow="89"
                  aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <p class="mt-4 mb-1" style="font-size: .77rem;">Data Mining and Analytics	</p>
              <div class="progress rounded" style="height: 5px;">
                <div class="progress-bar" role="progressbar" style="width: 55%" aria-valuenow="55"
                  aria-valuemin="0" aria-valuemax="100"></div>
              </div>
              <p class="mt-4 mb-1" style="font-size: .77rem;">Web Systems and Technology 2</p>
              <div class="progress rounded mb-2" style="height: 5px;">
                <div class="progress-bar" role="progressbar" style="width: 66%" aria-valuenow="66"
                  aria-valuemin="0" aria-valuemax="100"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
