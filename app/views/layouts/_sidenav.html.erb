<div class="row">
  <a class="navbar-brand mt-2 text-primary text-center" href="#">VI Room</a>
  <hr class='mt-2'>
  <div class="col-12 text-center">
    <%= link_to  root_path, class:'text-decoration-none' do %>
      <p class='fw-normal mb-0 text-primary'><%= bootstrap_icon 'speedometer2', width: '1rem', height: '1rem'%><span class='d-block text-white' style="font-size: .6rem;">Dashboard</span></p>
    <% end %>
  </div>
  <hr class='mt-2'>
  <div class="col-12  text-center">
    <p class='fw-bold mb-0 text-white' style="font-size: .6rem;">MANAGER</p>
  </div>
  <div class="col-12  text-center my-2">
    <div class="btn-group dropright" role="group" aria-label="Button group with nested dropdown">
      <a href='#' id="btnGroupDrop2" type="button" class="nav-link text-light" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <%= bootstrap_icon 'person-rolodex', width: '1rem', height: '1rem', class: 'text-primary'%>
      </a>
      <div class="dropdown-menu" aria-labelledby="btnGroupDrop2">
        <p class='ms-3 fw-bold mb-2 text-primary' style="font-size: .7rem;">START</p>
        <%= link_to "Create Classes/Metric Manager", new_class_subject_path, class: "dropdown-item" %>
        <%= link_to class_subjects_path, class: "text-decoration-none dropdown-item" do %>
          My Classes
        <% end %>
      </div>
    </div>
    <p class='fw-normal mb-0 text-white' style='font-size: .6rem'>Classes</p>
  </div>
  <hr class='mt-2'>
  <div class="col-12  text-center">
    <p class='fw-bold mb-0 text-white' style="font-size: .6rem;">PRO<span class='fw-bold d-block mb-0 text-white'  style="font-size: .6rem;">VERSION</p>
  </div>
  <div class="col-12  text-center my-2">
    <div class="btn-group dropright" role="group" aria-label="Button group with nested dropdown">
      <a href='#' id="btnGroupDrop2" type="button" class="nav-link text-light" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <%= bootstrap_icon 'folder', width: '1rem', height: '1rem', class: 'text-primary' %>
      </a>
      <div class="dropdown-menu" aria-labelledby="btnGroupDrop2">
        <a class="dropdown-item" href="#">Classes</a>
      </div>
    </div>
    <p class='fw-normal mb-0 text-white' style='font-size: .6rem'>Reports</p>
  </div>
  <hr class='mt-2'>
</div>
